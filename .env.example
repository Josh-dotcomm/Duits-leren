# Supabase URL + publishable key are baked into src/config/secrets.js, so the app
# works without this file. This .env is only for local development / overrides.

# OPTIONAL, local dev only: set this to call Groq directly from the app while you
# develop. It then lives only in this gitignored file and is NEVER shipped in the APK.
# Leave it unset to use the secure proxy (the Edge Functions hold the key server-side).
# Get a free key at https://console.groq.com/keys
# EXPO_PUBLIC_GROQ_API_KEY=gsk_...

# The Groq key used by the SHIPPED app is set on the server, not here:
#   supabase secrets set GROQ_API_KEY=gsk_...

# Supabase overrides (optional; defaults live in src/config/secrets.js).
# EXPO_PUBLIC_SUPABASE_URL=https://hxnsecgtgpjflkhijidx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_0NW6k8wt1urhdJAH8n5pMg_CCbuF1nt

# Optional model override (direct mode only; proxy mode decides this server-side).
# Default is openai/gpt-oss-120b at reasoning high. Lower these for more speed.
# EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b
# EXPO_PUBLIC_GROQ_REASONING=high

# NOTE: API keys are baked into src/config/secrets.js so the app works without a
# .env (handy for the APK). This file is only needed to OVERRIDE those values.
#
# Groq API key - get a free one at https://console.groq.com/keys
#
# SECURITY NOTE: variables prefixed with EXPO_PUBLIC_ are inlined into the
# app bundle and are therefore NOT secret. Anyone with the app can extract it.
# This is fine for local use / internal testing. For a public production app,
# proxy the Groq calls through your own backend and keep the key server-side.
#
# Copy this file to ".env" and fill in your key:
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# Supabase (auth + woordenboek). De publishable key is publiek-veilig.
EXPO_PUBLIC_SUPABASE_URL=https://hxnsecgtgpjflkhijidx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_0NW6k8wt1urhdJAH8n5pMg_CCbuF1nt

# Optioneel: AI-model. Standaard openai/gpt-oss-120b (beste, zelfcontrolerende
# grammaticacorrectie). Voor lagere latency: llama-3.3-70b-versatile. Voor maximale
# snelheid: llama-3.1-8b-instant. reasoning kan low/medium/high (alleen gpt-oss).
# EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b
# EXPO_PUBLIC_GROQ_REASONING=high
